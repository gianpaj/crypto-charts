{
  "name": "crypto-charts",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "check-types": "pnpm -r check-types",
    "dev:web": "pnpm --filter web dev",
    "db:push": "pnpm --filter @crypto-charts/db db:push",
    "db:studio": "pnpm --filter @crypto-charts/db db:studio",
    "db:generate": "pnpm --filter @crypto-charts/db db:generate",
    "db:migrate": "pnpm --filter @crypto-charts/db db:migrate",
    "db:local": "pnpm --filter @crypto-charts/db db:local",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@crypto-charts/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@crypto-charts/config": "workspace:*",
    "@types/node": "^22.13.14",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.7.0"
}
